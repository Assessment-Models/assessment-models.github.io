{
  "name": "assessment-models-gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "indexes": "node scripts/build-index.mjs",
    "dev": "npm run indexes && vite --host 0.0.0.0 --port 3000",
    "build": "npm run indexes && vite build",
    "build:site": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "esbuild --platform=node src/scoring/engine.test.ts --bundle --format=esm --outfile=.tmp/engine.test.mjs && node .tmp/engine.test.mjs"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "typescript": "~5.6.3",
    "vite": "^6.0.7"
  }
}
