{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assessment-models.github.io/schema/ecosystem-registry.schema.json",
  "title": "Assessment Models Ecosystem Registry",
  "description": "Deterministic catalog of repositories, maturity models, shared capabilities, and governance artifacts under Assessment-Models, extended with touchpoint and handshake contracts for the gateway metro map.",
  "type": "object",
  "required": [
    "schema_version",
    "organization",
    "generated_at",
    "content_sha256",
    "summary",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "organization": {
      "type": "object",
      "required": ["login", "url", "pages_url"],
      "properties": {
        "login": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "pages_url": { "type": "string", "format": "uri" }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "summary": {
      "type": "object",
      "required": ["total_artifacts", "by_layer", "standards"],
      "properties": {
        "total_artifacts": { "type": "integer", "minimum": 0 },
        "by_layer": {
          "type": "object",
          "properties": {
            "governance": { "type": "integer", "minimum": 0 },
            "maturity-model": { "type": "integer", "minimum": 0 },
            "assessment-model": { "type": "integer", "minimum": 0 },
            "shared-capability": { "type": "integer", "minimum": 0 },
            "integration": { "type": "integer", "minimum": 0 },
            "reference-blueprint": { "type": "integer", "minimum": 0 }
          }
        },
        "standards": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "full_name",
          "owner_type",
          "layer",
          "architectural_concern",
          "description",
          "html_url",
          "version",
          "license",
          "conformance_status",
          "updated_at"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "full_name": { "type": "string" },
          "owner_type": { "type": "string", "enum": ["cardinal-org", "partner-ecosystem"] },
          "layer": {
            "type": "string",
            "enum": [
              "governance",
              "maturity-model",
              "assessment-model",
              "shared-capability",
              "integration",
              "reference-blueprint"
            ]
          },
          "architectural_concern": {
            "type": "string",
            "minLength": 3,
            "description": "Canonical registry concerns: 'Maturity Model Architecture', 'Assessment Architecture', 'Model Ecosystem Integration Architecture', 'Organization Governance'. Repositories with an assessment-manifest.json declare their own domain concern (e.g. 'Technology', 'Operations'), which is preserved verbatim per AM-MODEL-REPOSITORY-STANDARD (M3)."
          },
          "description": { "type": "string" },
          "readme_excerpt": { "type": "string" },
          "html_url": { "type": "string", "format": "uri" },
          "default_branch": { "type": "string" },
          "version": { "type": "string" },
          "license": { "type": "string" },
          "primary_language": { "type": "string" },
          "topics": { "type": "array", "items": { "type": "string" } },
          "standards_alignment": { "type": "array", "items": { "type": "string" } },
          "locales": { "type": "array", "items": { "type": "string" } },
          "dimensions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "conformance_status": {
            "type": "string",
            "enum": [
              "verified",
              "draft",
              "external-aligned",
              "registered",
              "structural",
              "full"
            ],
            "description": "'registered', 'structural', and 'full' are the official AM-MODEL-REPOSITORY-STANDARD (M3) conformance levels declared by repository manifests; 'verified', 'draft', and 'external-aligned' are registry-inferred states for repositories without manifests."
          },
          "has_manifest": { "type": "boolean" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "touchpoints": {
      "description": "Shared semantic or capability touchpoint mappings connecting two or more stations (overlapping criteria, shared evidence types, OpenDEA crosswalks).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "from_station_id", "to_station_id"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "kind": { "type": "string", "const": "touchpoint" },
          "from_station_id": { "type": "string" },
          "to_station_id": { "type": "string" },
          "line_id": {
            "type": "string",
            "enum": [
              "governance",
              "maturity-model",
              "assessment-model",
              "shared-capability",
              "integration",
              "reference-blueprint"
            ]
          },
          "contract_summary": { "type": "string" },
          "compatibility": { "type": "string" }
        }
      }
    },
    "handshakes": {
      "description": "Explicit inter-model or cross-corridor handshake contracts governing operational exchanges, version compatibility, and change-impact propagation.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "from_station_id", "to_station_id"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "kind": { "type": "string", "const": "handshake" },
          "from_station_id": { "type": "string" },
          "to_station_id": { "type": "string" },
          "line_id": {
            "type": "string",
            "enum": [
              "governance",
              "maturity-model",
              "assessment-model",
              "shared-capability",
              "integration",
              "reference-blueprint"
            ]
          },
          "direction": {
            "type": "string",
            "enum": ["unidirectional", "bidirectional"]
          },
          "contract_summary": { "type": "string" },
          "compatibility": { "type": "string" }
        }
      }
    }
  }
}
